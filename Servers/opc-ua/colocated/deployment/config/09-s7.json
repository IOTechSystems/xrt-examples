{
  "Name": "s7",
  "Logger": "00-logger",
  "Library": "libxrt-s7-device-service.so",
  "Factory": "xrt_s7_device_service_factory",
  "ProfileDir": "${XRT_DEPLOYMENT_DIR}/s7/profiles",
  "StateDir": "${XRT_DEPLOYMENT_DIR}/s7/state",
  "Scheduler": "05-sched",
  "ThreadPool": "03-pool",
  "SchedulesThreadPool": "04-sched_pool",
  "Bus": "06-bus",
  "DeviceDownTimeout": 0,
  "AllowedFails": 0,
  "RequestQueueMax": 4,
  "CommandQueueMax": 4,
  "DiscoveryInterval": 0,
  "ScheduleDeadBand": 0,
  "DiscoverInitialValues": false,
  "AutoBatchSize": 0,
  "AutoBatchTimeout": 250,
  "PublishTags": true,
  "Timestamp": true,
  "AutoRegister": false,
  "PublishRegisteredDevices": false,
  "PublishAttributes": false,
  "EdgeXCompat": false,
  "ZeroNullReadings": false,
  "DiscardUnchangedReadings": true,
  "EnableResourceRegex": true,
  "EnableDiscovery": true,
  "PreloadCache": false,
  "LiveCheckInterval": 15000,
  "LiveCheckIntervalDelay": 0,
  "Driver": {}
}
