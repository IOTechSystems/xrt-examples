{
  "Name": "virtual",
  "Logger": "00-logger",
  "Library": "libxrt-virtual-device-service.so",
  "Factory": "xrt_virtual_device_service_factory",
  "ProfileDir": "${XRT_DEPLOYMENT_DIR}/virtual/profiles",
  "StateDir": "${XRT_DEPLOYMENT_DIR}/virtual/state",
  "Scheduler": "05-sched",
  "ThreadPool": "03-pool",
  "SchedulesThreadPool": "04-sched_pool",
  "Bus": "06-bus",
  "DeviceDownTimeout": 0,
  "AllowedFails": 0,
  "RequestQueueMax": 4,
  "CommandQueueMax": 4,
  "DiscoveryInterval": 0,
  "ScheduleDeadband": 0,
  "DiscoverInitialValues": false,
  "AutoBatchSize": 0,
  "AutoBatchTimeout": 250,
  "PublishTags": true,
  "Timestamp": false,
  "AutoRegister": false,
  "PublishRegisteredDevices": false,
  "PublishAttributes": false,
  "EdgeXCompat": false,
  "ZeroNullReadings": false,
  "DiscardUnchangedReadings": true,
  "EnableResourceRegex": true,
  "EnableDiscovery": true,
  "PreloadCache": false,
  "LiveCheckInterval": 15000,
  "LiveCheckIntervalDelay": 0,
  "Driver": {}
}
