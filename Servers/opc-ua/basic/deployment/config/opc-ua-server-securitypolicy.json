{
    "Library": "libxrt-opc-ua-server.so",
    "Factory": "xrt_opc_ua_server_factory",
    "ThreadPool": "pool",
    "Bus": "bus",
    "Logger": "logger",
    "ApplicationUri" : "${XRT_OPC_UA_APPLICATION_URI}",
    "SecurityPolicies": [
    {
      "SecurityPolicy": "Basic256Sha256",
      "Certificate": "${XRT_OPC_UA_X509_CERTIFICATE}",
      "PrivateKey": "${XRT_OPC_UA_X509_KEY}"
    },
    {
      "SecurityPolicy": "None"
    },
  ],
  "Endpoints": [
    {
      "SecurityPolicy": "Basic256Sha256",
      "MessageSecurityModes" : ["Sign"]
    },
    {
      "SecurityPolicy": "None",
      "DiscoveryOnly" : true
    }
  ]
}
