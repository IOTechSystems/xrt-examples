{
  "Name": "mqtt",
  "Logger": "00-logger",
  "Library": "libxrt-mqtt-bridge.so",
  "Factory": "xrt_mqtt_bridge_factory",
  "Bus": "06-bus",
  "AcksTimeout": 0,
  "AppTopic": "spBv1.0/STATE/XRT::MQTTBridge",
  "UseDispatchThread": true,
  "DispatchThreadQueueSizeMax": 0,
  "Patterns": [
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/DBIRTH/xrt-opc-ua-example-server/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ]
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/NBIRTH/xrt-opc-ua-example-server",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ]
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/DDEATH/xrt-opc-ua-example-server/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ]
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/NDEATH/xrt-opc-ua-example-server",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ]
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/DDATA/xrt-opc-ua-example-server/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ]
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/NDATA/xrt-opc-ua-example-server",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ]
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/DACK/xrt-opc-ua-example-server/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ]
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/NACK/xrt-opc-ua-example-server",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ]
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/REPLY/xrt-opc-ua-example-server/s7",
      "QoS": 0
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/REPLY/xrt-opc-ua-example-server/virtual",
      "QoS": 0
    }
  ],
  "MQTTPatterns": [
    {
      "Pattern": "spBv1.0/STATE/+",
      "QoS": 0
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/NCMD/xrt-opc-ua-example-server",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ]
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/REQUEST/xrt-opc-ua-example-server/s7",
      "QoS": 0
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/REQUEST/xrt-opc-ua-example-server/virtual",
      "QoS": 0
    }
  ],
  "MQTTDynamicPatterns": [
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/DCMD/xrt-opc-ua-example-server/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ]
    }
  ],
  "MQTTConfig": {
    "ServerURI": "${XRT_MQTT_BROKER}",
    "ClientID": "xrt-opc-ua-example-server",
    "QoS": 0,
    "ClientConfig": {
      "KeepAliveInterval": 60,
      "Username": "${XRT_MQTT_USERNAME}",
      "Password": "${XRT_MQTT_PASSWORD}",
      "ConnectTimeout": 0,
      "DisconnectTimeout": 0,
      "MQTTVersion": 5,
      "WillConfig": {
        "Topic": "spBv1.0/${SPARKPLUG_GROUP}/NDEATH/xrt-opc-ua-example-server",
        "QoS": 1,
        "Retain": false,
        "Transforms": [
          "${SPARKPLUG_PROTO}"
        ]
      },
      "CleanStart": true,
      "SessionExpiry": 0,
      "RetryInterval": 0,
      "MinRetryInterval": 1,
      "MaxRetryInterval": 60,
      "MaxBufferedMessages": 100
    },
    "FT_Mode": false
  }
}
