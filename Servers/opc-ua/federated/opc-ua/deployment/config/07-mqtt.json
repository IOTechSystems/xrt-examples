{
  "Name": "mqtt",
  "Logger": "00-logger",
  "Library": "libxrt-mqtt-bridge.so",
  "Factory": "xrt_mqtt_bridge_factory",
  "Bus": "06-bus",
  "QueueSize": 5,
  "Priority": 0,
  "AcksTimeout": 10,
  "AppTopic": "spBv1.0/STATE/XRT::MQTTBridge",
  "UseDispatchThread": false,
  "DispatchThreadQueueSizeMax": 0,
  "Patterns": [
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/NCMD/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ]
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/DCMD/+/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ]
    }
  ],
  "MQTTPatterns": [
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/STATE/+",
      "QoS": 0,
      "Sync": true
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/NBIRTH/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ],
      "Sync": false
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/NDEATH/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ],
      "Sync": false
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/NDATA/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ],
      "Sync": false
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/NACK/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ],
      "Sync": false
    }
  ],
  "MQTTDynamicPatterns": [
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/DBIRTH/+/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ],
      "Sync": false
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/DDEATH/+/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ],
      "Sync": false
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/DDATA/+/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ],
      "Sync": false
    },
    {
      "Pattern": "spBv1.0/${SPARKPLUG_GROUP}/DACK/+/+",
      "QoS": 0,
      "Transforms": [
        "${SPARKPLUG_PROTO}"
      ],
      "Sync": false
    }
  ],
  "MQTTConfig": {
    "ServerURI": "${XRT_MQTT_BROKER}",
    "ClientID": "${SPARKPLUG_NODE2}",
    "QoS": 0,
    "ClientConfig": {
      "KeepAliveInterval": 10,
      "Username": "${XRT_MQTT_USERNAME}",
      "Password": "${XRT_MQTT_PASSWORD}",
      "ConnectTimeout": 0,
      "DisconnectTimeout": 0,
      "MQTTVersion": 5,
      "CleanStart": true,
      "SessionExpiry": 0,
      "RetryInterval": 0,
      "MinRetryInterval": 1,
      "MaxRetryInterval": 60,
      "MaxBufferedMessages": 100
    },
    "FT_Mode": false
  }
}
