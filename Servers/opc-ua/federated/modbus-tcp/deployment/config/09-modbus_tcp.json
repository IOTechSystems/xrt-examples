{
  "Name": "modbus_tcp",
  "Logger": "00-logger",
  "Library": "libxrt-modbus-device-service.so",
  "Factory": "xrt_modbus_device_service_factory",
  "ProfileDir": "${XRT_DEPLOYMENT_DIR}/modbus_tcp/profiles",
  "StateDir": "${XRT_DEPLOYMENT_DIR}/modbus_tcp/state",
  "Scheduler": "05-sched",
  "ThreadPool": "03-pool",
  "SchedulesThreadPool": "04-sched_pool",
  "Bus": "06-bus",
  "DeviceDownTimeout": 60,
  "AllowedFails": 5,
  "RequestQueueMax": 4,
  "CommandQueueMax": 4,
  "DiscoveryInterval": 0,
  "ScheduleDeadBand": 0,
  "DiscoverInitialValues": false,
  "AutoBatchSize": 0,
  "AutoBatchTimeout": 250,
  "PublishTags": true,
  "Timestamp": true,
  "AutoRegister": false,
  "PublishRegisteredDevices": false,
  "PublishAttributes": false,
  "EdgeXCompat": false,
  "ZeroNullReadings": false,
  "DiscardUnchangedReadings": true,
  "EnableResourceRegex": true,
  "EnableDiscovery": true,
  "PreloadCache": false,
  "LiveCheckInterval": 15000,
  "LiveCheckIntervalDelay": 0,
  "Driver": {
    "DefaultRequestTimeout": 500,
    "WritePriority": 1
  }
}
