# Sparkplug group and node of the Xrt instance. The Alarm Service only follows the iotech group.
# Its alarm definitions and the eKuiper stream refer to the node by name, so change those too if
# you change it.
SPARKPLUG_GROUP=iotech
SPARKPLUG_NODE=bess-node

# Tutorial credentials. Change them before exposing the host to a network.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
GRAFANA_PASSWORD=admin
