{
  "uid": "bess-overview",
  "title": "Battery Energy Storage System",
  "description": "Rack, enclosure and site meter data stored by the Sparkplug Historian",
  "tags": [
    "tutorial",
    "bess"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "State of charge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "historian"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT v.captured_time AS time, h.device_id AS metric, v.float32_value AS value\nFROM sparkplug.metric_value v\nJOIN sparkplug.metric m ON m.metric_id = v.metric_id\nJOIN sparkplug.hierarchy h ON h.id = m.hierarchy_id\nWHERE m.metric_name = 'state-of-charge' AND $__timeFilter(v.captured_time)\nORDER BY 1",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "historian"
          }
        }
      ]
    },
