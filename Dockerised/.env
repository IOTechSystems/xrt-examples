XRT_IMAGE_VERSION="iotechsys/xrt-server:2.3.0-x86_64"
XRT_IMAGE_INSTALL_PATH="/opt/iotech/xrt/2.3"
# For xrt env
XRT_CONFIG_DIR="/opt/iotech/xrt/2.3/deployment/config"
XRT_LICENSE_FILE="/opt/iotech/xrt/2.3/IOTech_EdgeConnect_Developer.json"
XRT_MQTT_BROKER="mqtt://mqtt:1883"
XRT_MQTT_PASSWORD="pass"
XRT_MQTT_USERNAME="user"
XRT_PROFILE_DIR="/opt/iotech/xrt/2.3/deployment/profiles"
XRT_STATE_DIR="/opt/iotech/xrt/2.3/deployment/state"

# For influxdb env
XRT_INFLUXDB_BUCKET="test_bucket"
XRT_INFLUXDB_ORG="InfluxOrg"
XRT_INFLUXDB_USERNAME="admin"
XRT_INFLUXDB_PASSWORD="adminadminadmin"
XRT_INFLUXDB_SERVICE="http://influxdb:8086"
XRT_INFLUXDB_TOKEN="abcede=="
