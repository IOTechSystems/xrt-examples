# For compose file
XRT_IMAGE_VERSION="iotechsys/xrt:2.2"
XRT_IMAGE_INSTALL_PATH="/opt/iotech/xrt/2.2"

# For XRT containers
XRT_MQTT_BROKER="mqtt://mqtt:1883"
XRT_MQTT_USERNAME="user"
XRT_MQTT_PASSWORD="pass"
XRT_CONFIG_DIR="/opt/iotech/xrt/2.2/deployment/config"
XRT_PROFILE_DIR="/opt/iotech/xrt/2.2/deployment/profiles"
XRT_STATE_DIR="/opt/iotech/xrt/2.2/deployment/state"
XRT_LICENSE_FILE="/opt/iotech/xrt/2.2/IOTech_EdgeConnect_Developer.json"
