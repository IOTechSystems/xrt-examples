/// InfluxDB Exporter Example
/// Generates configuration for the Virtual device service exporting data to an InfluxDB v2
/// bucket, with a dedicated debug logger on the exporter. Device service data is published as
/// Sparkplug, so the exporter runs a Sparkplug application (sparkplug_config) to export it, on a
/// standard node, whose Sparkplug node publishes the NBIRTH the application requires.
extends "@XRT/core/standard_node.pkl"

import "@XRT/core/XRT.pkl"
import "@XRT/devices/virtual.pkl"
import "@XRT/export/influxdb.pkl"
import "@XRT/bridge/sparkplug_bridge.pkl"

/// The simulated virtual device and its polling schedule
local virtual_device = virtual.device(
  "Motor",
  "MotorSim",
  new virtual.VirtualProtocolType {},
)

/// A dedicated Debug-level logger for the InfluxDB exporter, separate from the node's shared
/// Warn-level logger.
local exporter_logger = new XRT.Logger {
  name = "logger_debug"
  level = "Debug"
}

local base = standardSystem("influxdb-server", "${SPARKPLUG_NODE}")

local exporter = new influxdb.InfluxDBExporter {
  name = "influxdb2_exporter"
  logger = exporter_logger.ref()
  bus = base.std._bus.ref()
  influx_version = 2
  server_uri = "${XRT_INFLUXDB_SERVICE}"
  bucket = "${XRT_INFLUXDB_BUCKET}"
  org = "${XRT_INFLUXDB_ORG}"
  token = "${XRT_INFLUXDB_TOKEN}"
  measurement = "DeviceName"
  tags = Set("TagDeviceName", "TagScheduleName")
  sparkplug_config = new influxdb.InfluxDBSparkplugConfig {}
  sparkplug_thread_pool = base.std._pool.ref()
  batch_config = new influxdb.InfluxDB_BatchConfig {
    batch_size = 5
    batch_timeout = 5.s
    scheduler = base.std._scheduler.ref()
    thread_pool = base.std._pool.ref()
  }
  connect_timeout = 4.s
  timeout = 1.5.s
}

system =
  base
    |> sparkplug_bridge.replaceWithOpts("mqtt", new Dynamic {
        device_services = List("virtual_device_service")
      })
    |> addComponents(new Listing<XRT.Component> { exporter_logger; exporter })
    |> virtual.instance("virtual_device_service")
    |> withLogLevel("Warn")
    |> withSparkplugNodeOptions((s) -> (s) {
        wait_timeout = 5
        heartbeat_interval = 0.s
      })
    |> withDevices("virtual_device_service", Set(virtual_device))
    |> withSchedules("virtual_device_service", Set(
        virtual_device.new_scheduleWithOpts("schedule1", Set("MachineState"), 500.ms, (s) -> (s) {
          tags = Map("ScheduleName", "schedule1")
        }),
      ))

output {
  files = system.deployment()
}
