{
  "Name": "export_aws",
  "Logger": "1-logger_debug",
  "Library": "libxrt-mqtt-bridge.so",
  "Factory": "xrt_mqtt_bridge_factory",
  "Bus": "5-bus",
  "AcksTimeout": 0,
  "UseDispatchThread": true,
  "DispatchThreadQueueSizeMax": 0,
  "Patterns": [
    {
      "Pattern": "device/#",
      "QoS": 1,
      "Retain": false
    }
  ],
  "MQTTPatterns": [],
  "MQTTDynamicPatterns": [],
  "MQTTConfig": {
    "ServerURI": "${MQTT_EXPORT_AWS_SERVER_URI}",
    "ClientID": "${MQTT_EXPORT_AWS_CLIENT_ID}",
    "QoS": 1,
    "ClientConfig": {
      "KeepAliveInterval": 60,
      "ConnectTimeout": 30,
      "DisconnectTimeout": 0,
      "MQTTVersion": 4,
      "SSLConfig": {
        "SSLVersion": 3,
        "EnableServerCertAuth": true,
        "TrustStore": "${MQTT_EXPORT_AWS_TRUST_STORE}",
        "KeyStore": "${MQTT_EXPORT_AWS_KEY_STORE}",
        "PrivateKey": "${MQTT_EXPORT_AWS_PRIVATE_KEY}",
        "EnabledCipherSuites": "ALL"
      },
      "CleanStart": true,
      "SessionExpiry": 0,
      "RetryInterval": 0,
      "MinRetryInterval": 5,
      "MaxRetryInterval": 60,
      "MaxBufferedMessages": 10
    },
    "FT_Mode": false
  }
}
