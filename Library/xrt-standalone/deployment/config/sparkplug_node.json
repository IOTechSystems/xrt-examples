{
  "Name": "sparkplug_node",
  "Logger": "logger",
  "Library": "libxrt-sparkplug.so",
  "Factory": "xrt_sparkplug_factory",
  "Bus": "bus",
  "Scheduler": "sched",
  "ThreadPool": "pool",
  "StateDir": "${XRT_STATE_DIR}/sparkplug",
  "NodeId": "${SPARKPLUG_NODE1}",
  "WaitTimeout": 5,
  "EnableMetricLog": false,
  "EnableExitCmd": true,
  "EnableDiscovery": true,
  "EnableGroupCmd": true,
  "EnableServices": true,
  "EnableFixedAliases": false,
  "HeartbeatInterval": 0,
  "CommandQueueMax": 0,
  "AppStateWait": []
}
