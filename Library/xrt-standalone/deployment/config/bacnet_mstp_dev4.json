{
  "Library": "libxrt-bacnet-mstp-device-service.so",
  "Factory": "xrt_bacnet_mstp_device_service_factory",
  "Name": "bacnet_mstp_dev4",
  "QueueMax": 100000,
  "AutoRegister": false,
  "DiscoveryInterval": 0,
  "PublishRegisteredDevices": true,
  "PublishAttributes": true,
  "PublishServerId": true,
  "ProfileDir": "${XRT_STATE_DIR}/bacnet_mstp_dev4/profiles",
  "StateDir": "${XRT_STATE_DIR}/bacnet_mstp_dev4",
  "Group": "${SPARKPLUG_GROUP}",
  "Scheduler": "sched",
  "Logger": "logger_debug",
  "ThreadPool": "pool",
  "SchedulesThreadPool": "devpool",
  "Bus": "bus",
  "DeviceDownTimeout": 60,
  "AllowedFails": 5,
  "Driver": {
    "DeviceObject": {
      "InstanceID": 0
    },
    "SerialInterface": "/tmp/dev4-mstp",
    "APDUTimeout": 3000,
    "APDURetries": 3,
    "MultiBatchSize": 20,
    "MultiRead": true,
    "MultiWrite": true,
    "CancelStaleCOV": true,
    "DiscoverMode": "All"
  }
}
