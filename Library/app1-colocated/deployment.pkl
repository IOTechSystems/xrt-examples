extends "@XRT/core/standard_node.pkl"

import "@XRT/devices/bacnet.pkl"
import "@XRT/bridge/sparkplug_bridge.pkl"
import "../common/spg_demo_app.pkl"

system =
  standardSystem("app1-colocated-server", "${SPARKPLUG_NODE}")
    |> addComponents(new Listing<Component> {
        new Logger {
          name = "logger_debug"
          level = "Debug"
        }
        new ThreadPool {
          name = "spgapp_pool"
          logger = new LoggerRef { target = "logger" }
          threads = 5
        }
        new spg_demo_app.SparkplugDemoApp {
          name = "spg_demo_app"
          logger = new LoggerRef { target = "logger" }
          bus = new BusRef { target = "bus" }
          thread_pool = new ThreadPoolRef { target = "spgapp_pool" }
          app_id = "XRTLibSparkplugDemo"
          write_device = "Dev1"
          write_metric = "analog_output_0:present-value"
          write_value = 456.0
        }
      })
    |> sparkplug_bridge.replaceWithOpts("mqtt_bridge", new Dynamic {
        app_topic = "spBv1.0/STATE/XRT::MQTTBridge"
      })
    |> withLogLevel("Info")
    |> withSparkplugNodeOptions((n) -> (n) {
        app_state_wait = List()
      })
    |> bacnet.ip_instance("", "bacnet_ip_dev1")
    |> withOptions("bacnet_ip_dev1", new Dynamic {
        profile_dir = "${XRT_STATE_DIR}/bacnet_ip_dev1/profiles"
        state_dir = "${XRT_STATE_DIR}/bacnet_ip_dev1"
        schedules_thread_pool = new ThreadPoolRef { target = "sched_pool" }
        driver = new bacnet.BACnetIPDriverOptions {
          network_interface = ""
          device_object = new bacnet.BACnetDeviceObjectType {
            instance_id = 0
          }
        }
      })
    |> withDevices("bacnet_ip_dev1", Set(dev1))
    |> addAllResourcesSchedule("bacnet_ip_dev1", dev1, 3.s)
    |> bacnet.mstp_instance("/tmp/dev2-mstp", "bacnet_mstp_dev2")
    |> withOptions("bacnet_mstp_dev2", new Dynamic {
        profile_dir = "${XRT_STATE_DIR}/bacnet_mstp_dev2/profiles"
        state_dir = "${XRT_STATE_DIR}/bacnet_mstp_dev2"
        logger = new LoggerRef { target = "logger_debug" }
        schedules_thread_pool = new ThreadPoolRef { target = "sched_pool" }
        driver = new bacnet.BACnetMSTPDriverOptions {
          serial_interface = "/tmp/dev2-mstp"
          device_object = new bacnet.BACnetDeviceObjectType {
            instance_id = 0
          }
        }
      })
    |> withDevices("bacnet_mstp_dev2", Set(dev2))
    |> addAllResourcesSchedule("bacnet_mstp_dev2", dev2, 3.s)

local dev1 = bacnet.device("Dev1", "bacnet-ip-sim-profile", new bacnet.IPProtocolType {
  instance_id = 1234
})

local dev2 = bacnet.device("Dev2", "bacnet-ip-sim-profile", new bacnet.MSTPProtocolType {
  instance_id = 1235
})

// Only the device service state (devices/schedules) is written out as files.
// The component config (the "config/" entries of system.deployment()) is
// compiled into spg_demo instead, from deployment_config.h.
// TODO: generate deployment_config.h from here too, once the XRT Pkl schema
// can render component config as C string constants.
output {
  files = system.deployment().toMap().filter((path, _) -> path.startsWith("state/")).toMapping()
}
