{
  "Name": "opc_ua",
  "Logger": "03-logger_debug",
  "Library": "libxrt-opcua-device-service.so",
  "Factory": "xrt_opcua_device_service_factory",
  "ProfileDir": "${XRT_DEPLOYMENT_DIR}/opc_ua/profiles",
  "StateDir": "${XRT_DEPLOYMENT_DIR}/opc_ua/state",
  "Scheduler": "04-sched",
  "ThreadPool": "05-pool",
  "SchedulesThreadPool": "06-sched_pool",
  "Bus": "07-bus",
  "AllowedFails": 5,
  "RequestQueueMax": 4,
  "CommandQueueMax": 4,
  "DiscoveryInterval": 300,
  "ScheduleDeadBand": 0,
  "DiscoverInitialValues": false,
  "AutoBatchSize": 0,
  "AutoBatchTimeout": 250,
  "Timestamp": true,
  "AutoRegister": false,
  "PublishRegisteredDevices": true,
  "PublishAttributes": true,
  "EdgeXCompat": false,
  "PublishSource": false,
  "ZeroNullReadings": false,
  "EnableDiscovery": true,
  "PreloadCache": false,
  "LiveCheckInterval": 15000,
  "LiveCheckIntervalDelay": 0,
  "Driver": {
    "LDSName": "LDS"
  }
}
