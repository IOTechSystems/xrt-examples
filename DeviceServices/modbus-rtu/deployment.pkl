/// Modbus RTU Device Service Example
/// Generates configuration for the Modbus RTU device service with Sparkplug MQTT bridge.
extends "@XRT/core/standard_node.pkl"

import "@XRT/devices/modbus.pkl"
import "@XRT/bridge/sparkplug_bridge.pkl"

/// The simulated Modbus RTU device and its polling schedule
local modbus_sim = modbus.device(
  "modbus-sim",
  "modbus-sim-profile",
  new modbus.RTUProtocolType {
    address = "/tmp/virtualport"
    baud_rate = 19200
    data_bits = 8
    stop_bits = 1
    parity = "N"
    unit_id = 1
  },
)

/// Create the standard system with Modbus RTU device service
system =
  standardSystem("modbus-rtu-server", "${SPARKPLUG_NODE}")
    |> sparkplug_bridge.replaceWithOpts("mqtt", new Dynamic {
        device_services = List("modbus-rtu")
      })
    |> withPoolThreads(10)
    |> withSchedulePoolThreads(6)
    |> withLogLevel("Warn")
    |> withSparkplugNodeOptions(new Dynamic {
        wait_timeout = 5
        heartbeat_interval = 0.s
      })
    |> modbus.instance("modbus-rtu")
    |> withOptions("modbus-rtu", new Dynamic {
        device_down_timeout = 60.s
        allowed_fails = 5
      })
    |> withDevices("modbus-rtu", Set(modbus_sim))
    |> withSchedules("modbus-rtu", Set(
        modbus_sim.new_schedule(new Dynamic {
          name = "modbus-sim-schedule"
          device = modbus_sim.ref()
          resource = Set("Current")
          interval = 1.s
        }),
      ))

output {
  files = system.deployment()
}
