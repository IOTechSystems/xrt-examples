/// S7 Device Service Example
/// Generates configuration for the S7 device service with Sparkplug MQTT bridge.
extends "@XRT/core/standard_node.pkl"

import "@XRT/devices/s7.pkl"
import "@XRT/bridge/sparkplug_bridge.pkl"

/// Create the standard system with S7 device service
system =
  standardSystem("s7-server", "${SPARKPLUG_NODE}")
    |> sparkplug_bridge.replaceWithOpts("mqtt", new Dynamic {
        device_services = List("s7")
      })
    |> withPoolThreads(10)
    |> withSchedulePoolThreads(6)
    |> withLogLevel("Warn")
    |> withSparkplugNodeOptions(new Dynamic {
        wait_timeout = 5
        heartbeat_interval = 0.s
      })
    |> s7.instance("s7")
    |> withOptions("s7", new Dynamic {
        publish_registered_devices = true
        publish_attributes = true
      })

output {
  files = system.deployment()
}
