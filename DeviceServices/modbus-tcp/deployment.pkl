/// Modbus TCP Device Service Example
/// Generates configuration for the Modbus TCP device service with Sparkplug MQTT bridge.
extends "@XRT/core/standard_node.pkl"

import "@XRT/devices/modbus.pkl"
import "@XRT/bridge/sparkplug_bridge.pkl"

/// The simulated Modbus TCP device and its polling schedule
local modbus_sim = modbus.device(
  "modbus-sim",
  "modbus-sim-profile",
  new modbus.TCPProtocolType {
    address = "0.0.0.0"
    port = 1502
    unit_id = 1
  },
)

/// Create the standard system with Modbus TCP device service
system =
  standardSystem("modbus-tcp-server", "${SPARKPLUG_NODE}")
    |> sparkplug_bridge.replaceWithOpts("mqtt", new Dynamic {
        device_services = List("modbus-tcp")
      })
    |> withPoolThreads(10)
    |> withSchedulePoolThreads(6)
    |> withLogLevel("Warn")
    |> withSparkplugNodeOptions(new Dynamic {
        wait_timeout = 5
        heartbeat_interval = 0.s
      })
    |> modbus.instance("modbus-tcp")
    |> withOptions("modbus-tcp", new Dynamic {
        device_down_timeout = 60.s
        allowed_fails = 5
      })
    |> withDevices("modbus-tcp", Set(modbus_sim))
    |> withSchedules("modbus-tcp", Set(
        modbus_sim.new_schedule(new Dynamic {
          name = "modbus-example-schedule1"
          device = modbus_sim.ref()
          resource = Set("Current")
          interval = 1.s
        }),
      ))

output {
  files = system.deployment()
}
