{
  "Name": "sparkplug_node",
  "Logger": "00-logger",
  "Library": "libxrt-sparkplug.so",
  "Factory": "xrt_sparkplug_factory",
  "Bus": "06-bus",
  "Scheduler": "05-sched",
  "ThreadPool": "03-pool",
  "StateDir": "${XRT_STATE_DIR}/sparkplug",
  "NodeId": "${SPARKPLUG_NODE}",
  "WaitTimeout": 5,
  "EnableMetricLog": true,
  "EnableExitCmd": true,
  "EnableDiscovery": true,
  "EnableGroupCmd": true,
  "EnableServices": true,
  "EnableFixedAliases": false,
  "HeartbeatInterval": 0,
  "CommandQueueMax": 0,
  "AppStateWait": [
    "${SPARKPLUG_APPS}"
  ]
}
